<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAttachmentIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_attachment"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="document.pdf"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvAttachmentMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF • 145 KB"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAttachmentAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="OPEN WITH"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="@drawable/bg_btn_action"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Download Progress Bar & Status (Visible during active stream) -->
    <ProgressBar
        android:id="@+id/pbAttachmentDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvAttachmentProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <!-- Embedded Image Preview (Visible only for image attachments) -->
    <ImageView
        android:id="@+id/ivAttachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="260dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_input"
        android:padding="2dp"
        android:visibility="gone" />

</LinearLayout>
